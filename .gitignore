# YOLOv8 & VISÃO COMPUTACIONAL
# =============================================================================
# Pastas de treinamento, predições e caches do Ultralytics
runs/
*.onnx
*.engine
*.torchscript

# Modelos base padrão baixados automaticamente pelo YOLO
yolov8n.pt
yolov8s.pt
yolov8m.pt
yolov8l.pt
yolov8x.pt

# (Nota: 'models/best.pt' não é ignorado para que os pesos do projeto subam ao repositório)

